model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Customers","Date","Products","README","Sales","Targets","Main_Table"]

ref table Customers
ref table Date
ref table Products
ref table README
ref table Sales
ref table Targets
ref table Main_Table

ref cultureInfo en-US

